{{define "models"}}
<section class="page-head">
  <div>
    <h1>Model Catalog &amp; Registry</h1>
    <p class="muted">Live models parsed from TypeScript registry definitions with dynamic fallback &amp; alias resolution</p>
  </div>
  <div class="pills">
    <span class="pill pill-safe">{{.Count}} registered models</span>
    <span class="pill">{{.Agents}} upstream agents</span>
  </div>
</section>

<div class="table-wrap">
  <table class="model-table">
    <thead>
      <tr>
        <th scope="col">Model Identifier (ID)</th>
        <th scope="col">Upstream Agent Binding</th>
      </tr>
    </thead>
    <tbody>
    {{range .Models}}
      <tr>
        <td class="mono"><strong>{{.ID}}</strong></td>
        <td class="mono">{{if .Agent}}{{.Agent}}{{else}}<span class="muted">—</span>{{end}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
</div>

{{if .HasAliases}}
<section class="card aliases-card" style="margin-top: 1.5rem;">
  <h2>Active Model Aliases</h2>
  <p class="muted">Configured in <code>MODEL_ALIASES</code> — client requests requesting the alias are transparently rewritten to the target model.</p>
  <div class="table-wrap" style="margin-top: 0.75rem;">
    <table class="model-table">
      <thead>
        <tr>
          <th scope="col">Client Alias</th>
          <th scope="col">Target Model ID</th>
        </tr>
      </thead>
      <tbody>
      {{range .Aliases}}
        <tr>
          <td class="mono"><strong>{{.Alias}}</strong></td>
          <td class="mono">{{.Real}}</td>
        </tr>
      {{end}}
      </tbody>
    </table>
  </div>
</section>
{{end}}
{{end}}
