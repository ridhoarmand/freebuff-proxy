{{define "smoke_result"}}
<p class="result result-ok" role="status">Smoke test OK — <span class="mono">{{.Model}}</span> via {{.Token}} in {{.Ms}}ms.</p>
{{if .Phases}}
<div class="smoke-phases" style="margin-top: 0.6rem; display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center;">
  <span class="muted" style="font-size: 0.8rem; font-weight: 600; margin-right: 0.25rem;">Phase Timing:</span>
  {{range $i, $p := .Phases}}
    <span class="pill mono" style="font-size: 0.76rem; background: var(--fp-surface-2); border: 1px solid var(--fp-border); border-radius: var(--fp-radius-xs);">{{$p.Name}}={{$p.Ms}}ms</span>
  {{end}}
</div>
{{end}}
{{if .Preview}}<pre class="smoke-preview mono">{{.Preview}}</pre>{{end}}
{{end}}
