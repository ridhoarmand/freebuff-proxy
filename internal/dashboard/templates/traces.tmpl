{{define "traces"}}
<section class="page-head">
  <div>
    <h1>Live Request Traces</h1>
    <p class="muted">Recent chat routing decisions, latency timings, and error classifications — refreshes every 3s</p>
  </div>
  <div class="pills">
    <span class="pill pill-{{if .Enabled}}safe{{else}}pool{{end}}">{{if .Enabled}}Ring Active (200 records){{else}}Ring Disabled{{end}}</span>
  </div>
</section>

{{if not .Enabled}}
<article class="card empty-card">
  <h2>Trace viewer disabled</h2>
  <p>The log ring was not initialized (started without the dashboard log handler).</p>
</article>
{{else if not .Traces}}
<article class="card empty-card">
  <h2>No chat traffic yet</h2>
  <p class="muted">Live chat completions will appear here automatically with microsecond phase latency breakdowns.</p>
</article>
{{else}}
<div class="table-wrap">
  <table class="trace-table">
    <thead>
      <tr>
        <th scope="col">Time</th>
        <th scope="col">Token</th>
        <th scope="col">Model ID</th>
        <th scope="col">Status</th>
        <th scope="col">Duration</th>
        <th scope="col">Details / Error</th>
      </tr>
    </thead>
    <tbody>
    {{range .Traces}}
      <tr class="trace-{{.Status}}{{if .Error}} trace-err{{end}}">
        <td class="mono trace-time">{{.Time}}</td>
        <td class="mono"><strong>{{.Token}}</strong></td>
        <td class="mono">{{.Model}}</td>
        <td>
          <span class="pill {{if eq .Status "ok"}}pill-safe{{else if eq .Status "rate_limited"}}risk-elevated{{else}}risk-critical{{end}} trace-status">{{.Status}}</span>
        </td>
        <td class="mono">{{.Ms}}</td>
        <td class="mono trace-error">{{if .Error}}{{.Error}}{{else}}<span class="muted">—</span>{{end}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
</div>
{{end}}
{{end}}
