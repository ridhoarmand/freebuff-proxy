{{define "layout"}}<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#11131a">
<meta name="htmx-config" content='{"selfRequestsOnly":true,"allowScriptTags":false}'>
<title>freebuff-proxy · admin</title>
<link rel="stylesheet" href="/admin/assets/pico.min.css">
<link rel="stylesheet" href="/admin/assets/app.css">
<script src="/admin/assets/htmx.min.js" defer></script>
</head>
<body>
<header class="site">
  <nav class="container">
    <div class="nav-brand-wrap">
      <a href="/admin" class="brand">freebuff-proxy <span class="brand-sub">admin</span></a>
      {{if .HasUpdate}}<a href="{{.UpdateURL}}" class="update-badge" title="new release available">update: {{.LatestVersion}}</a>{{end}}
    </div>
    <ul class="nav-menu">
      <li><a href="/admin" class="nav-link{{if eq .Page "overview"}} active{{end}}">Overview</a></li>
      <li><a href="/admin/tokens" class="nav-link{{if eq .Page "tokens"}} active{{end}}">Tokens</a></li>
      <li><a href="/admin/models" class="nav-link{{if eq .Page "models"}} active{{end}}">Models</a></li>
      <li><a href="/admin/traces" class="nav-link{{if eq .Page "traces"}} active{{end}}">Traces</a></li>
      <li><a href="/admin/playground" class="nav-link{{if eq .Page "playground"}} active{{end}}">Playground</a></li>
      <li><a href="/admin/config" class="nav-link{{if eq .Page "config"}} active{{end}}">Config</a></li>
      <li><a href="/admin/setup" class="nav-link{{if eq .Page "setup"}} active{{end}}">Setup</a></li>
      <li><a href="/admin/logs" class="nav-link{{if eq .Page "logs"}} active{{end}}">Logs</a></li>
      <li><a href="/admin/metrics" class="nav-link{{if eq .Page "metrics"}} active{{end}}">Metrics</a></li>
    </ul>
  </nav>
  {{if .OpenBanner}}
  <div class="open-banner container" role="status">
    <strong>Dashboard is open — no ADMIN_TOKEN set.</strong>
    This proxy is reachable from a non-loopback address and the admin UI is
    unauthenticated: any client that can reach it can view state and change
    configuration. Set <code>ADMIN_TOKEN</code> in <a href="/admin/config">Config</a>
    to require a login.
  </div>
  {{end}}
</header>
<main class="container">
  <div id="{{.Page}}-root">{{.Body}}</div>
</main>
{{if eq .Page "overview"}}<div hx-get="/admin" hx-trigger="every 5s" hx-target="#overview-root" hx-swap="innerHTML" hidden></div>{{end}}
{{if eq .Page "tokens"}}<div hx-get="/admin/tokens" hx-trigger="every 30s" hx-target="#tokens-root" hx-swap="innerHTML" hidden></div>{{end}}
{{if eq .Page "logs"}}<div hx-get="/admin/logs" hx-trigger="every 3s" hx-target="#logs-root" hx-swap="innerHTML" hx-include="#logs-filter" hidden></div>{{end}}
{{if eq .Page "traces"}}<div hx-get="/admin/traces" hx-trigger="every 3s" hx-target="#traces-root" hx-swap="innerHTML" hidden></div>{{end}}
{{if eq .Page "metrics"}}<div hx-get="/admin/metrics" hx-trigger="every 5s" hx-target="#metrics-root" hx-swap="innerHTML" hidden></div>{{end}}
<footer class="container muted">
  <p>single binary · htmx driven · <a href="/healthz">healthz</a> · <a href="/metrics">metrics</a></p>
</footer>
<script>
// Issue #50a: render every [data-utc] timestamp in the BROWSER's local
// timezone (zero build step). The server ships RFC3339 UTC; this converts
// on load and every 30s so long-open pages stay fresh.
(function () {
  function formatLocal(el) {
    var iso = el.getAttribute("data-utc");
    if (!iso) return;
    var d = new Date(iso);
    if (isNaN(d.getTime())) return;
    var s = d.toLocaleString(undefined, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
    el.textContent = s + " (local)";
  }
  function convertAll() {
    document.querySelectorAll("time[data-utc]").forEach(formatLocal);
  }
  convertAll();
  setInterval(convertAll, 30000);
})();
</script>
</body>
</html>
{{end}}
