{{define "layout"}}<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0B101A">
<meta name="htmx-config" content='{"selfRequestsOnly":true,"allowScriptTags":false}'>
<title>freebuff-proxy · admin</title>
<link rel="stylesheet" href="/admin/assets/pico.min.css">
<link rel="stylesheet" href="/admin/assets/app.css">
<script src="/admin/assets/htmx.min.js" defer></script>
</head>
<body>
<header class="site">
  <nav class="container">
    <div class="nav-brand-wrap">
      <a href="/admin" class="brand">freebuff-proxy <span class="brand-sub">admin</span></a>
      {{if .HasUpdate}}<a href="{{.UpdateURL}}" class="update-badge" title="new release available">update: {{.LatestVersion}}</a>{{end}}
    </div>
    <button class="hamburger" aria-label="Toggle menu" onclick="document.querySelector('.nav-menu').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-menu" role="menubar">
      <li role="none"><a href="/admin" role="menuitem" class="nav-link{{if eq .Page "overview"}} active{{end}}"><span class="nav-icon" aria-hidden="true">⊞</span> Overview</a></li>
      <li role="none"><a href="/admin/tokens" role="menuitem" class="nav-link{{if eq .Page "tokens"}} active{{end}}"><span class="nav-icon" aria-hidden="true">🔑</span> Tokens</a></li>
      <li role="none"><a href="/admin/models" role="menuitem" class="nav-link{{if eq .Page "models"}} active{{end}}"><span class="nav-icon" aria-hidden="true">⚡</span> Models</a></li>
      <li role="none"><a href="/admin/traces" role="menuitem" class="nav-link{{if eq .Page "traces"}} active{{end}}"><span class="nav-icon" aria-hidden="true">⏱</span> Traces</a></li>
      <li role="none"><a href="/admin/playground" role="menuitem" class="nav-link{{if eq .Page "playground"}} active{{end}}"><span class="nav-icon" aria-hidden="true">▶</span> Playground</a></li>
      <li role="none"><a href="/admin/config" role="menuitem" class="nav-link{{if eq .Page "config"}} active{{end}}"><span class="nav-icon" aria-hidden="true">⚙</span> Config</a></li>
      <li role="none"><a href="/admin/setup" role="menuitem" class="nav-link{{if eq .Page "setup"}} active{{end}}"><span class="nav-icon" aria-hidden="true">✦</span> Setup</a></li>
      <li role="none"><a href="/admin/logs" role="menuitem" class="nav-link{{if eq .Page "logs"}} active{{end}}"><span class="nav-icon" aria-hidden="true">≡</span> Logs</a></li>
      <li role="none"><a href="/admin/metrics" role="menuitem" class="nav-link{{if eq .Page "metrics"}} active{{end}}"><span class="nav-icon" aria-hidden="true">📊</span> Metrics</a></li>
    </ul>
  </nav>
</header>
<main class="container">
  <div id="{{.Page}}-root">{{.Body}}</div>
</main>
{{if eq .Page "overview"}}<div hx-get="/admin" hx-trigger="every 5s" hx-target="#overview-root" hx-swap="innerHTML" hidden></div>{{end}}
{{if eq .Page "tokens"}}<div hx-get="/admin/tokens" hx-trigger="every 30s" hx-target="#tokens-root" hx-swap="innerHTML" hidden></div>{{end}}
{{if eq .Page "logs"}}<div hx-get="/admin/logs" hx-trigger="every 3s" hx-target="#logs-root" hx-swap="innerHTML" hx-include="#logs-filter" hidden></div>{{end}}
{{if eq .Page "traces"}}<div hx-get="/admin/traces" hx-trigger="every 3s" hx-target="#traces-root" hx-swap="innerHTML" hidden></div>{{end}}
{{if eq .Page "metrics"}}<div hx-get="/admin/metrics" hx-trigger="every 5s" hx-target="#metrics-root" hx-swap="innerHTML" hidden></div>{{end}}
<footer class="container muted">
  <p>single binary · htmx driven · <a href="/healthz">healthz</a> · <a href="/metrics">metrics</a></p>
</footer>
<script>
// Issue #50a: render every [data-utc] timestamp in the BROWSER's local
// timezone (zero build step). The server ships RFC3339 UTC; this converts
// on load and every 30s so long-open pages stay fresh.
(function () {
  function formatLocal(el) {
    var iso = el.getAttribute("data-utc");
    if (!iso) return;
    var d = new Date(iso);
    if (isNaN(d.getTime())) return;
    var s = d.toLocaleString(undefined, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
    el.textContent = s + " (local)";
  }
  function convertAll() {
    document.querySelectorAll("time[data-utc]").forEach(formatLocal);
  }
  convertAll();
  setInterval(convertAll, 30000);
})();
</script>
<script>
// Keyboard navigation: 1-9 jump to nav links
(function () {
  var links = document.querySelectorAll('.nav-link');
  document.addEventListener('keydown', function (e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
    var n = parseInt(e.key, 10);
    if (n >= 1 && n <= links.length) {
      e.preventDefault();
      links[n - 1].click();
    }
  });
})();
</script>
</body>
</html>
{{end}}
