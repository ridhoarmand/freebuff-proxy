{{define "layout"}}<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b0d14">
<meta name="htmx-config" content='{"selfRequestsOnly":true,"allowScriptTags":false}'>
<title>freebuff-proxy · admin</title>
<link rel="stylesheet" href="/admin/assets/pico.min.css">
<link rel="stylesheet" href="/admin/assets/app.css">
<script src="/admin/assets/htmx.min.js" defer></script>
</head>
<body>
<header class="site">
  <nav class="container">
    <div class="nav-brand-wrap">
      <a href="/admin" class="brand">
        <span class="pulse-dot" title="Proxy relay online"></span>
        <span>freebuff-proxy</span>
        <span class="brand-sub">admin</span>
      </a>
      {{if .HasUpdate}}<a href="{{.UpdateURL}}" class="update-badge" title="New release available" target="_blank" rel="noopener">update: {{.LatestVersion}}</a>{{end}}
    </div>
    <ul class="nav-menu" role="menubar">
      <li role="none"><a href="/admin" role="menuitem" class="nav-link{{if eq .Page "overview"}} active{{end}}" data-key="1"><span class="nav-icon" aria-hidden="true">⊞</span> Overview</a></li>
      <li role="none"><a href="/admin/tokens" role="menuitem" class="nav-link{{if eq .Page "tokens"}} active{{end}}" data-key="2"><span class="nav-icon" aria-hidden="true">🔑</span> Tokens</a></li>
      <li role="none"><a href="/admin/models" role="menuitem" class="nav-link{{if eq .Page "models"}} active{{end}}" data-key="3"><span class="nav-icon" aria-hidden="true">⚡</span> Models</a></li>
      <li role="none"><a href="/admin/traces" role="menuitem" class="nav-link{{if eq .Page "traces"}} active{{end}}" data-key="4"><span class="nav-icon" aria-hidden="true">⏱</span> Traces</a></li>
      <li role="none"><a href="/admin/playground" role="menuitem" class="nav-link{{if eq .Page "playground"}} active{{end}}" data-key="5"><span class="nav-icon" aria-hidden="true">▶</span> Playground</a></li>
      <li role="none"><a href="/admin/config" role="menuitem" class="nav-link{{if eq .Page "config"}} active{{end}}" data-key="6"><span class="nav-icon" aria-hidden="true">⚙</span> Config</a></li>
      <li role="none"><a href="/admin/setup" role="menuitem" class="nav-link{{if eq .Page "setup"}} active{{end}}" data-key="7"><span class="nav-icon" aria-hidden="true">✦</span> Setup</a></li>
      <li role="none"><a href="/admin/logs" role="menuitem" class="nav-link{{if eq .Page "logs"}} active{{end}}" data-key="8"><span class="nav-icon" aria-hidden="true">≡</span> Logs</a></li>
      <li role="none"><a href="/admin/metrics" role="menuitem" class="nav-link{{if eq .Page "metrics"}} active{{end}}" data-key="9"><span class="nav-icon" aria-hidden="true">📊</span> Metrics</a></li>
    </ul>
  </nav>
</header>
<main class="container">
  <div id="{{.Page}}-root">{{.Body}}</div>
</main>
{{if eq .Page "overview"}}<div hx-get="/admin" hx-trigger="every 5s" hx-target="#overview-root" hx-swap="innerHTML" hidden></div>{{end}}
{{if eq .Page "tokens"}}<div hx-get="/admin/tokens" hx-trigger="every 30s" hx-target="#tokens-root" hx-swap="innerHTML" hidden></div>{{end}}
{{if eq .Page "logs"}}<div hx-get="/admin/logs" hx-trigger="every 3s" hx-target="#logs-root" hx-swap="innerHTML" hx-include="#logs-filter" hidden></div>{{end}}
{{if eq .Page "traces"}}<div hx-get="/admin/traces" hx-trigger="every 3s" hx-target="#traces-root" hx-swap="innerHTML" hidden></div>{{end}}
{{if eq .Page "metrics"}}<div hx-get="/admin/metrics" hx-trigger="every 5s" hx-target="#metrics-root" hx-swap="innerHTML" hidden></div>{{end}}
<footer class="container muted">
  <p>single binary · htmx driven · <a href="/healthz">healthz</a> · <a href="/metrics">metrics</a></p>
</footer>
<script>
// Issue #50a: render every [data-utc] timestamp in the BROWSER's local
// timezone (zero build step). The server ships RFC3339 UTC; this converts
// on load and every 30s so long-open pages stay fresh.
(function () {
  function formatLocal(el) {
    var iso = el.getAttribute("data-utc");
    if (!iso) return;
    var d = new Date(iso);
    if (isNaN(d.getTime())) return;
    var s = d.toLocaleString(undefined, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
    el.textContent = s + " (local)";
  }
  function convertAll() {
    document.querySelectorAll("time[data-utc]").forEach(formatLocal);
  }
  convertAll();
  setInterval(convertAll, 30000);

  // Keyboard navigation shortcuts: numbers 1-9 switch tabs when not typing
  document.addEventListener("keydown", function (e) {
    if (e.target && (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA" || e.target.tagName === "SELECT" || e.target.isContentEditable)) return;
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    var key = e.key;
    if (key >= "1" && key <= "9") {
      var link = document.querySelector('.nav-link[data-key="' + key + '"]');
      if (link && !link.classList.contains("active")) {
        link.click();
      }
    }
  });
})();
</script>
</body>
</html>
{{end}}
