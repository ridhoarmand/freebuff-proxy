{{define "tokens"}}
<section class="page-head">
  <div>
    <h1>Token Pool &amp; Quotas</h1>
    <p class="muted">Live per-token session health, cooldown locks, and model admission quotas</p>
  </div>
  <div class="pills">
    <span class="pill pill-{{if .InBridge}}bridge{{else if eq .Mode "hybrid"}}hybrid{{else}}pool{{end}}">{{.Mode}}</span>
    {{if .InBridge}}<span class="pill">{{.BridgeTokens}} bridge client{{if ne .BridgeTokens 1}}s{{end}}</span>{{end}}
  </div>
</section>

{{if .InBridge}}
<article class="card bridge-card">
  <h2>Bridge mode (Zero-Storage Relay)</h2>
  <p>Upstream tokens are relayed per client request ({{.BridgeTokens}} active bridge client{{if ne .BridgeTokens 1}}s{{end}}); session state and quota are per-client and are not tracked here.</p>
  <p class="muted">Paste a FreeBuff token below to switch to pooled mode — it is added live and persisted to <code>.env</code> immediately.</p>
</article>
{{else if not .HasTokens}}
<article class="card empty-card">
  <h2>No Tokens Configured</h2>
  <p>Paste a FreeBuff token (<code>cb_...</code>) below to start the pooled relay.</p>
</article>
{{else}}
<article class="card mode-card">
  <h2>{{if eq .Mode "hybrid"}}Hybrid mode{{else}}Pooled mode{{end}} — {{.TokenCount}} Active Token(s)</h2>
  {{if eq .Mode "hybrid"}}<p class="muted">Hybrid: client-supplied Bearer tokens relay in bridge mode; token-less requests use the pool below.</p>{{end}}
  <p class="muted">Live operational actions: Test, Unlock, and Finish act on the active pool immediately without downtime.</p>
  <div class="token-actions-bar">
    <button class="action-btn btn-danger" hx-post="/admin/tokens/remove" hx-confirm="Remove the last token from the pool and .env?" hx-target="#token-result" hx-swap="innerHTML">Remove last token</button>
    <button class="action-btn btn-mode" hx-post="/admin/mode" hx-vals='{"mode":"hybrid"}' hx-confirm="Switch to hybrid mode? Pooled tokens stay; clients with a token relay it, token-less requests use the pool." hx-target="#token-result" hx-swap="innerHTML">Switch to hybrid mode</button>
    <button class="action-btn btn-mode" hx-post="/admin/mode" hx-vals='{"mode":"bridge"}' hx-confirm="Switch to bridge mode? All pooled tokens are removed." hx-target="#token-result" hx-swap="innerHTML">Switch to bridge mode</button>
  </div>
</article>
{{end}}

<article class="card add-token-card">
  <div class="add-token-header">
    <h2>+ Add Token to Pool</h2>
    <p class="muted">Paste a FreeBuff auth token (<code>cb_...</code>) — appended to the live pool and saved to <code>.env</code> with zero downtime.</p>
  </div>
  <form hx-post="/admin/tokens/add" hx-target="#token-result" hx-swap="innerHTML" class="inline-token-form">
    <label for="new-token" class="visually-hidden">Token</label>
    <input type="text" id="new-token" name="token" placeholder="Paste FreeBuff token (cb_...)" autocomplete="off" spellcheck="false" class="mono input-token" required>
    <button type="submit" class="action-btn btn-test">Add to pool</button>
  </form>
</article>

<div class="tokens-control-bar">
  <p class="muted manage-note">Advanced: <code>AUTH_TOKENS</code> can also be edited directly in <a href="/admin/config">Config</a>.</p>
  {{if not .InBridge}}<button class="action-btn btn-test" hx-post="/admin/tokens/test-all" hx-target="#token-result" hx-swap="innerHTML">⚡ Test all tokens (Zero-Cost)</button>{{end}}
</div>
<div id="token-result"></div>

{{range .Tokens}}
<article class="card token-detail">
  <header class="token-head">
    <span class="state-dot dot-{{.RiskLevel}}" title="Risk tier: {{.RiskLevel}}"></span>
    <strong class="token-name">Token {{.Index}}</strong>
    <span class="pill risk-{{.RiskLevel}}">{{.RiskLevel}}</span>
    {{if .HasStanding}}<span class="pill standing-pill" title="Upstream account standing">trust {{.StandingLabel}} · {{printf "%.0f" .StandingScore}}/100{{if .StandingNextLevel}} → {{.StandingNextLevel}}{{end}}</span>{{end}}
    <span class="pill">{{.SessionStatus}}</span>
    <span class="token-actions">
      {{if .CooldownActive}}<button class="action-btn btn-unlock" hx-post="/admin/tokens/{{.Index}}/unlock" hx-confirm="Unlock Token {{.Index}}? Only do this if you know the cooldown/ban is stale." hx-target="#token-result" hx-swap="innerHTML">🔓 Unlock</button>{{end}}
      <button class="action-btn btn-test" hx-post="/admin/tokens/{{.Index}}/test" hx-target="#token-result" hx-swap="innerHTML">⚡ Test</button>
      <button class="action-btn btn-finish" hx-post="/admin/tokens/{{.Index}}/finish" hx-confirm="Finish all active runs of Token {{.Index}}? In-flight requests are unaffected." hx-target="#token-result" hx-swap="innerHTML">⟳ Finish runs</button>
    </span>
  </header>
  <dl class="kv kv-4">
    <div><dt>session id</dt><dd class="mono">{{.SessionInstance}}</dd></div>
    <div><dt>active runs</dt><dd class="mono">{{.ActiveRuns}}</dd></div>
    <div><dt>total requests</dt><dd class="mono">{{.Requests}}</dd></div>
    <div><dt>messages 24h</dt><dd class="mono">{{.Messages24h}}{{if gt .DailyLimit 0}} / {{.DailyLimit}}{{end}}</dd></div>
    {{if gt .QueueDepth 0}}<div><dt>queue position</dt><dd class="mono">{{.QueuePosition}}/{{.QueueDepth}}</dd></div>{{end}}
    {{if .CooldownActive}}<div><dt>cooldown until</dt><dd class="mono">{{.CooldownUntil}}</dd></div>{{end}}
    {{if gt .TransientRetries 0}}<div><dt>transient retries</dt><dd class="mono">{{.TransientRetries}}</dd></div>{{end}}
    {{if and .HasStanding .StandingNextLevelAt}}<div><dt>next level at</dt><dd class="mono">{{.StandingNextLevelAt}}</dd></div>{{end}}
  </dl>
  {{if gt .DailyLimit 0}}
  <div class="usage {{if ge .UsagePct 80}}usage-near{{end}}"><div class="usage-bar" style="width: {{.UsagePct}}%"></div></div>
  <p class="muted usage-label">{{.UsagePct}}% of daily message limit</p>
  {{end}}
  {{if .HasQuota}}
  <h3 class="quota-heading">Session quota by model</h3>
  <div class="table-wrap">
    <table class="quota-table">
      <thead>
        <tr><th scope="col">Model ID</th><th scope="col">Recent</th><th scope="col">Limit</th><th scope="col">Period</th><th scope="col">Reset Time</th><th scope="col">Entitlement</th></tr>
      </thead>
      <tbody>
      {{range .Quota}}
        <tr>
          <td class="mono"><strong>{{.Model}}</strong></td>
          <td class="mono">{{.Recent}}</td>
          <td class="mono">{{.Limit}}</td>
          <td class="mono">{{.Period}}</td>
          <td class="mono">{{if .ResetAtUTC}}<time data-utc="{{.ResetAtUTC}}">{{.ResetAt}}</time>{{else}}{{.ResetAt}}{{end}}{{if .ResetsIn}} <span class="countdown{{if .NearLimit}} countdown-near{{end}}">{{.ResetsIn}}</span>{{end}}</td>
          <td class="mono">{{if .HasEntitlement}}{{.Entitled}}{{end}}</td>
        </tr>
        {{if .HasBar}}
        <tr class="quota-bar-row">
          <td colspan="6"><div class="usage {{if .NearLimit}}usage-near{{end}}"><div class="usage-bar" style="width: {{.UsagePct}}%"></div></div></td>
        </tr>
        {{end}}
      {{end}}
      </tbody>
    </table>
  </div>
  {{end}}
</article>
{{end}}
{{end}}
