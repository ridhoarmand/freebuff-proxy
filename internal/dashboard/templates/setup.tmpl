{{define "setup"}}
<section class="page-head">
  <div>
    <h1>Client setup</h1>
    <p class="muted">Three simple steps from zero to a fully connected AI coding environment</p>
  </div>
  <div class="pills">
    <span class="pill mono">{{.BaseURL}}</span>
    <span class="pill pill-{{if .Bridge}}bridge{{else if eq .Mode "hybrid"}}hybrid{{else}}pool{{end}}">{{.Mode}} mode</span>
  </div>
</section>

{{if .Bridge}}
<article class="card step-card">
  <h2><span class="step">1</span> Add your token (switches to pooled mode)</h2>
  <p class="muted">The proxy currently relays tokens sent by client headers (bridge mode). Paste a FreeBuff token to run a pooled relay with health tracking — added live without restart.</p>
  <form hx-post="/admin/tokens/add" hx-target="#setup-result" hx-swap="innerHTML" class="smoke-form">
    <label for="wiz-token" class="visually-hidden">Token</label>
    <input type="text" id="wiz-token" name="token" placeholder="Paste FreeBuff token (cb_...)" autocomplete="off" spellcheck="false" class="mono" required>
    <button type="submit" class="action-btn btn-test">Add to pool</button>
  </form>
  <div id="setup-result"></div>
</article>
{{else}}
<article class="card step-card">
  <h2><span class="step">1</span> Token Pool Status — {{.TokenCount}} Token(s) Active</h2>
  <p class="muted">Add credentials to increase throughput or switch routing mode.</p>
  <form hx-post="/admin/tokens/add" hx-target="#setup-result" hx-swap="innerHTML" class="smoke-form">
    <label for="wiz-token" class="visually-hidden">Token</label>
    <input type="text" id="wiz-token" name="token" placeholder="Paste FreeBuff token (cb_...)" autocomplete="off" spellcheck="false" class="mono" required>
    <button type="submit" class="action-btn btn-test">Add token</button>
  </form>
  <div class="token-actions-bar" style="margin-top: 0.75rem;">
    <button class="action-btn btn-danger" hx-post="/admin/tokens/remove" hx-confirm="Remove the last token?" hx-target="#setup-result" hx-swap="innerHTML">🗑 Remove last</button>
    <button class="action-btn btn-test" hx-post="/admin/tokens/test-all" hx-target="#setup-result" hx-swap="innerHTML">⚡ Test all</button>
    <button class="action-btn btn-mode" hx-post="/admin/mode" hx-vals='{"mode":"bridge"}' hx-confirm="Switch to bridge mode? Pooled tokens are removed." hx-target="#setup-result" hx-swap="innerHTML">⇄ Switch to bridge</button>
  </div>
  <div id="setup-result"></div>
</article>
{{end}}

<article class="card step-card">
  <h2><span class="step">2</span> Verify Proxy Pipeline</h2>
  <p class="muted">Run a smoke test or diagnostics to confirm upstream admission and TLS stealth reachability.</p>
  <form hx-post="/admin/smoke" hx-target="#setup-smoke" hx-swap="innerHTML" class="smoke-form">
    <select name="model" aria-label="Model">
      {{range .Models}}<option value="{{.}}">{{.}}</option>{{end}}
    </select>
    <input type="text" name="prompt" value="ping" maxlength="200" placeholder="prompt">
    <button type="submit" class="action-btn btn-test">⚡ Run test</button>
  </form>
  <div id="setup-smoke"></div>
  <div class="token-actions-bar" style="margin-top: 0.75rem;">
    <button class="action-btn" hx-post="/admin/diag" hx-target="#setup-diag" hx-swap="innerHTML">🩺 Full diagnostics</button>
  </div>
  <div id="setup-diag"></div>
</article>

<article class="card step-card">
  <h2><span class="step">3</span> Connect Your AI Coding Tools</h2>
  <p class="muted">Client API Key: <strong>{{.KeyHint}}</strong> • Base URL: <code class="mono">{{.BaseURL}}</code></p>
  <div class="setup-grid">
    <div class="setup-snippet">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3>OpenCode</h3>
        <button type="button" class="action-btn" onclick="copySnippet(this)" style="font-size: 0.72rem !important; padding: 0.2rem 0.5rem !important;">Copy</button>
      </div>
      <pre class="mono">"freebuff": {"type": "openai", "options": {"baseURL": "{{.BaseURL}}", "apiKey": "not-needed"}}</pre>
    </div>
    <div class="setup-snippet">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3>Continue / Cline</h3>
        <button type="button" class="action-btn" onclick="copySnippet(this)" style="font-size: 0.72rem !important; padding: 0.2rem 0.5rem !important;">Copy</button>
      </div>
      <pre class="mono">models:
  - title: "FreeBuff"
    provider: "openai"
    model: "{{.Model}}"
    apiBase: "{{.BaseURL}}"
    apiKey: "not-needed"</pre>
    </div>
    <div class="setup-snippet">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3>aider</h3>
        <button type="button" class="action-btn" onclick="copySnippet(this)" style="font-size: 0.72rem !important; padding: 0.2rem 0.5rem !important;">Copy</button>
      </div>
      <pre class="mono">openai-api-base: {{.BaseURL}}
openai-api-key: not-needed
model: {{.Model}}</pre>
    </div>
    <div class="setup-snippet">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3>9router</h3>
        <button type="button" class="action-btn" onclick="copySnippet(this)" style="font-size: 0.72rem !important; padding: 0.2rem 0.5rem !important;">Copy</button>
      </div>
      <pre class="mono">Name:     freebuff
Prefix:   freebuff
API type: Chat Completions
Base URL: {{.BaseURL}}
Model ID: {{.Model}}</pre>
    </div>
    <div class="setup-snippet">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3>cURL</h3>
        <button type="button" class="action-btn" onclick="copySnippet(this)" style="font-size: 0.72rem !important; padding: 0.2rem 0.5rem !important;">Copy</button>
      </div>
      <pre class="mono">curl -N {{.BaseURL}}/chat/completions \
  -H "Authorization: Bearer &lt;token-or-key&gt;" \
  -H "Content-Type: application/json" \
  -d '{"model":"{{.Model}}","messages":[{"role":"user","content":"hi"}],"stream":true}'</pre>
    </div>
  </div>
</article>

<article class="card step-card">
  <h2><span class="step">+</span> Headless OAuth Token Generator</h2>
  <p class="muted">Generate credentials directly in browser without installing the Codebuff CLI. The token is automatically added to the live pool and saved to <code>.env</code>.</p>
  <button class="action-btn btn-test" id="login-start" onclick="fbLoginStart(this)">✦ Generate token via browser login</button>
  <div id="login-wizard" style="margin-top: 0.85rem;"></div>
  <script>
    var fbLoginPollTimer = null;
    function fbLoginStart(btn) {
      var box = document.getElementById('login-wizard');
      btn.disabled = true;
      box.innerHTML = '<p class="muted">Starting headless login flow…</p>';
      fetch('/admin/login/start', {method: 'POST'})
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.fingerprint) {
            box.innerHTML = '<p>Open this URL in your browser to sign in:</p>' +
              '<p><a href="' + d.login_url + '" target="_blank" rel="noopener" class="pill mono">' + d.login_url + '</a></p>' +
              '<p class="muted">Waiting for you to complete sign-in (polling status)...</p>';
            fbLoginPollTimer = setInterval(function () { fbLoginPoll(d.fingerprint); }, 3000);
          } else {
            box.innerHTML = '<p class="result result-err">' + (d.message || 'Login start failed — please try again.') + '</p>';
            btn.disabled = false;
          }
        })
        .catch(function () { box.innerHTML = '<p class="result result-err">Login start failed — network error.</p>'; btn.disabled = false; });
    }
    function fbLoginPoll(fp) {
      var box = document.getElementById('login-wizard');
      fetch('/admin/login/status?fingerprint=' + encodeURIComponent(fp))
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.status === 'completed') {
            clearInterval(fbLoginPollTimer);
            box.innerHTML = '<p class="result result-ok">✓ Token added to pool (Token #' + d.token_index + ') and persisted to <code>.env</code>.</p>';
            document.getElementById('login-start').disabled = false;
          } else if (d.status === 'error') {
            clearInterval(fbLoginPollTimer);
            box.innerHTML = '<p class="result result-err">Login failed: ' + (d.message || 'unknown error') + '</p>';
            document.getElementById('login-start').disabled = false;
          }
        })
        .catch(function () { /* transient — keep polling */ });
    }
    function copySnippet(btn) {
      var pre = btn.closest('.setup-snippet').querySelector('pre');
      if (!pre) return;
      navigator.clipboard.writeText(pre.textContent).then(function () {
        var old = btn.textContent;
        btn.textContent = "Copied! ✓";
        setTimeout(function () { btn.textContent = old; }, 1800);
      });
    }
  </script>
</article>

{{if .Models}}
<section class="card models-card">
  <h2>Model Catalog ({{len .Models}} Active Models)</h2>
  <div class="model-chips" style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.6rem;">
  {{range .Models}}<span class="pill mono">{{.}}</span>{{end}}
  </div>
</section>
{{end}}
{{end}}
