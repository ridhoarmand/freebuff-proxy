{{define "metrics"}}
<section class="page-head">
  <div>
    <h1>Telemetry &amp; Metrics</h1>
    <p class="muted">Counter trends sampled every 5s; raw Prometheus exposition at <a href="/metrics" target="_blank" rel="noopener">/metrics</a></p>
  </div>
  <div class="pills">
    <span class="pill">{{.Models}} models</span>
    <span class="pill">{{.SampleCount}} samples cached</span>
  </div>
</section>

<div class="metric-grid">
  <article class="card metric-card">
    <h2>Requests served</h2>
    <p class="metric-value mono">{{.RequestsTotal}}</p>
    <div class="sparkline">{{.RequestsSpark}}</div>
  </article>
  <article class="card metric-card">
    <h2>Transient retries</h2>
    <p class="metric-value mono">{{.TransientRetries}}</p>
    <div class="sparkline">{{.RetriesSpark}}</div>
  </article>
  <article class="card metric-card">
    <h2>Fingerprint rotations</h2>
    <p class="metric-value mono">{{.FingerprintRotations}}</p>
    <p class="muted" style="font-size: 0.78rem; margin: 0.5rem 0 0;">Stealth browser profile swaps</p>
  </article>
</div>

<article class="card" style="margin-top: 1rem;">
  <h2>Prometheus Integration</h2>
  <p class="muted">Live Prometheus metrics are exposed at <code>/metrics</code> for Grafana, Datadog, or Prometheus scrapers. Includes per-token counters, cooldown locks, session status, and phase latencies.</p>
  <div style="margin-top: 0.5rem;">
    <a href="/metrics" target="_blank" rel="noopener" class="action-btn btn-test" style="display: inline-flex; text-decoration: none;">📊 Open Raw /metrics Feed</a>
  </div>
</article>
{{end}}
